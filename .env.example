# Copy to .env. All keys optional; defaults live in backend/app/config.py.
AT_PORT=8000
# Phase 14 B3: what this deployment declares itself bound to. Loopback by default (matches
# uvicorn's own default local-dev bind); write endpoints stay open with no AT_API_KEY set ONLY
# when AT_HOST is loopback AND AT_DEMO_MODE=true. docker-compose.yml sets AT_HOST=0.0.0.0 (the
# container must accept connections from outside itself), so it also needs AT_API_KEY set -- the
# placeholder below covers local demo writes. The private Compose profile enables Firebase
# authentication instead; configure server credentials and membership as documented.
AT_HOST=127.0.0.1
AT_CORS_ORIGINS=["http://localhost:5173"]
AT_SEED=42
AT_SIM_HZ=10
AT_WS_PERIOD_S=0.5
AT_HAI_DIR=../data/hai
AT_HAI_FILE=test1   # which HAI test file the replay walks
AT_HAI_SPEED=10    # HAI replay speed, rows/s, clamped to 1-20
AT_REPORTS_DIR=../reports
AT_W_DEVIATION=0.6
AT_W_ONSET=0.2
AT_W_CAUSAL=0.2
# Demo protection: POST /api/attack, /reset, /mode need header X-API-Key == AT_API_KEY.
# Empty AT_API_KEY = open (local dev only). VITE_API_KEY is bundled into the browser build, so it
# deters misuse of an exposed demo; it is not user authentication. Change both before exposing.
AT_API_KEY=change-me-demo-key
VITE_API_KEY=change-me-demo-key
AT_DEMO_MODE=true
AT_ATTACK_RATE_PER_MIN=10
# Phase 14 B4: the attack rate limit keys on the socket peer by default. Set true only behind a
# reverse proxy you trust to set X-Forwarded-For correctly -- an untrusted client can otherwise
# spoof that header to dodge the limit.
AT_TRUST_PROXY=false
AT_GATE_MARGIN=0.21

# Plant emulator (LIVE mode source): Modbus TCP on EMU_PORT, health on EMU_HEALTH_PORT.
# Local default binds loopback only; the compose service sets EMU_HOST=0.0.0.0 inside the container.
EMU_HOST=127.0.0.1
EMU_PORT=5020
EMU_HEALTH_PORT=8081
EMU_SEED=42
EMU_HZ=10
EMU_TAGMAP=config/tagmap.yaml

# LIVE mode source (Modbus TCP read-only client). Defaults point at the plant emulator on loopback.
# Start a loopback-only Modbus plant emulator inside the backend when nothing is already
# listening on AT_LIVE_PORT, so LIVE works without a second terminal. Set false to use an
# emulator you start yourself (`make emulator`) or a real PLC network.
AT_EMBED_EMULATOR=true
AT_LIVE_HOST=127.0.0.1
AT_LIVE_PORT=5020
AT_LIVE_TAGMAP=../config/tagmap.yaml
AT_LIVE_POLL_S=0.25
AT_LIVE_TIMEOUT_S=1.0
AT_LIVE_STALE_AFTER_S=1.0
AT_LIVE_MAX_AGE_S=5.0
AT_LIVE_FROZEN_AFTER_S=30.0
AT_LIVE_MAX_IN_FLIGHT=2
AT_LIVE_BLOCK_GAP=8
AT_LIVE_BACKOFF_BASE_S=0.25
AT_LIVE_BACKOFF_MAX_S=5.0
AT_LIVE_TRAIN_MIN=5
AT_LIVE_DB=../data/live_incidents.sqlite
AT_LIVE_INCLUDE_BAD_QUALITY=false

# Attacker tool (Phase 13 Part D, emulator-only): extra hosts it may write to, beyond loopback and
# the "plant-emulator" compose service name. Comma-separated. Empty by default; no flag bypasses
# the allowlist. Named AT_ATTACKER_ALLOWLIST to match this project's AT_ prefix convention.
AT_ATTACKER_ALLOWLIST=
## Private-server access (requires server ADC/workload identity; never a browser service key).
AT_AUTH_ENABLED=false
AT_FIREBASE_PROJECT_ID=attacktrace-private-20261016
AT_AUTH_COOKIE_SECURE=true
AT_AUTH_MEMBERS={}
# Optional edge origin lock. Leave empty for local/Compose; cloud entrypoint requires 32+ chars.
# Use the same random secret in the Cloudflare Worker secret GATEWAY_SECRET. Never use VITE_*.
AT_GATEWAY_SECRET=

# AI Pilot: keep this key on the backend. Optional comma-separated pools are ordered fallbacks.
GEMINI_API_KEY=
AT_AI_TEXT_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
AT_AI_LIVE_MODELS=gemini-3.8-live,gemini-2.5-flash-native-audio-latest
AT_AI_TRANSCRIPTION_MODELS=gemini-3.5-transcribe
AT_AI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
